{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    // Tasks are used for running NetLogo headlessly from inside VScode
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Update and open .nlogox model",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "python3 '${workspaceFolder}/.vscode/replace_nlogox_code.py' '${workspaceFolder}/Contemplative_Landscapes_ABM.nlogox' '${workspaceFolder}/src.nls' '${workspaceFolder}/Contemplative_Landscapes_ABM.nlogox' && /home/jerom/NetLogo/netlogo-gui.sh '${workspaceFolder}/Contemplative_Landscapes_ABM.nlogox'"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
