extensions [gis nw time csv]

;; INIT ;;

;; Location breeds

breed [home-locations home-location]
breed [work-locations work-location]
breed [shop-locations shop-location]

home-locations-own [ nearest-intersection ]
work-locations-own [ nearest-intersection ]
shop-locations-own [ nearest-intersection ]

;; Network breeds

breed [intersections intersection]   ; nodes = steet intersections
undirected-link-breed [streets street] ; edges = street segments

breed [sample-points sample-point]

streets-own [
  street-name
  length-meters
]

sample-points-own [
  biodiversity-score
  layers-score
  archetypal-score
  peace-score
  CLM-score

  visits
]

;; Resident breeds

breed [residents resident]
breed [resident-groups resident-group]
breed [export-residents export-resident]

residents-own [
  resident-id
  group

  home-node
  work-node
  
  current-goal
  destination
  current-path
  next-node
  moving?
  
  biodiversity-scores
  layers-scores
  archetypal-scores
  peace-scores
  CLM-scores
]

resident-groups-own [
  group-name
  group-proportion
  work-start-hour
  work-start-spread
  work-end-hour
  work-end-spread
  shop-probability
  shop-duration
  shop-end-spread
]

export-residents-own [
  res_id
  res_group

  biodiv_scr
  layers_scr
  archtp_scr
  peace_scr
  CLM_scr
]

;; Globals

globals [
  seed

  start-daytime
  time-of-day
  day
  today
  
  sample-point-dataset
  street-dataset
  work-dataset
  home-dataset
  shop-dataset
  
  intersection-snap-distance
  meter-conversion-factor
  view-distance-netlogo 
]

;; SETUP PROCEDURES ;;

to setup
  clear-all
  
  set start-daytime time:create-with-format "01-01-2000 00:00:00" "dd-MM-yyyy HH:mm:ss"
  
  print "Loading GIS data..."

  gis:load-coordinate-system "data/model_input/street_network.prj"
  
  ; Load streets
  set street-dataset gis:load-dataset "data/model_input/street_network.shp"
  let gis-envelope gis:envelope-of street-dataset
  gis:set-world-envelope (gis-envelope)

  ; Load sample points
  set sample-point-dataset gis:load-dataset "data/model_input/score_points.shp"
  
  ; Load other GIS data
  set home-dataset gis:load-dataset "data/model_input/homes.shp"
  set work-dataset gis:load-dataset "data/model_input/workplaces.shp"
  set shop-dataset gis:load-dataset "data/model_input/shops.shp"
  
  ; Calculate the ratio betwen meters and netlogo units
  ; Calculate both width and height to account for padding
  let gis-width item 1 gis-envelope - item 0 gis-envelope
  let gis-height item 3 gis-envelope - item 2 gis-envelope
  let netlogo-width max-pxcor - min-pxcor
  let netlogo-height max-pycor - min-pycor
  
  let x-factor netlogo-width / gis-width
  let y-factor netlogo-height / gis-height
  set meter-conversion-factor min (list x-factor y-factor)
  
  print "Creating world..."
  print (word "\t1 meter equals " meter-conversion-factor " net logo units.")
    
  ; Build the network and place locations
  set intersection-snap-distance 1 * meter-conversion-factor
  build-network
  load-sample-points
  load-home-locations
  load-work-locations
  load-shop-locations

  nw:set-context intersections streets
  
  ; Initialize agents, time and ticks
  reset
  print "Setup complete!\n"
end

to reset
  print "Resetting simulation..."
  
  reset-ticks

  ask resident-groups [ die ]
  ask residents [ die ]

  set day 0
  set today start-daytime
  set time-of-day time:anchor-to-ticks start-daytime 1.0 "minute"
  time:anchor-schedule start-daytime 1.0 "minute"

  set seed new-seed
  random-seed seed
  print (word "\tRandom seed for this simulation: " seed) 
  
  print "Loading resident groups..."
  load-resident-groups

  print (word "Adding " n-starting-residents " residents...")
  add-residents n-starting-residents
end

;; Network

to build-network
  foreach gis:feature-list-of street-dataset [ feature ->
    foreach gis:vertex-lists-of feature [ vertex-list ->

      let previous-node nobody

      foreach vertex-list [ vertex ->
        let location gis:location-of vertex
        
        if not empty? location [
          let x item 0 location
          let y item 1 location
          
          ; Create or reuse an intersection at this coordinate
          let current-node find-or-create-node x y
          
          ; Link consecutive vertices as a street segment
          if previous-node != nobody and previous-node != current-node [
            ask previous-node [
              create-street-with current-node [
                set length-meters gis:property-value feature "length"
                set color gray
              ]
            ]
          ]
          set previous-node current-node
        ]
      ]
    ]
  ]
end

to-report find-or-create-node [x y]
  let existing intersections with [
    abs (xcor - x) < intersection-snap-distance and abs (ycor - y) < intersection-snap-distance
  ]
  
  if any? existing [ report one-of existing ]

  let new-node nobody
  create-intersections 1 [
    setxy x y
    set color white
    set shape "circle"
    set size 0.2
    set new-node self
  ]
  report new-node
end

;; Sample points

to load-sample-points
  foreach gis:feature-list-of sample-point-dataset [ feature ->
    let location gis:location-of gis:centroid-of feature

    if not empty? location [
      let x item 0 location
      let y item 1 location
      
      create-sample-points 1 [
        setxy x y
        set biodiversity-score gis:property-value feature "biodiv_scr"
        set layers-score gis:property-value feature "layers_scr"
        set archetypal-score gis:property-value feature "arch_scr"
        set peace-score gis:property-value feature "peace_scr"
        set CLM-score gis:property-value feature "CLM_scr"
        set hidden? true  ; hide by default, can toggle for debugging
      ]
    ]
  ]
end

;; Locations

to-report find-nearest-intersection
  report min-one-of intersections [ distance myself ]
end

to load-home-locations
  foreach gis:feature-list-of home-dataset [ feature ->
    let location gis:location-of gis:centroid-of feature 
    
    if not empty? location [
      let x item 0 location
      let y item 1 location
      
      create-home-locations 1 [
        setxy x y
        set color lime
        set shape "square"
        set size 4
        set nearest-intersection find-nearest-intersection
      ]
    ]
  ]
end

to load-work-locations
  foreach gis:feature-list-of work-dataset [ feature ->
    let location gis:location-of gis:centroid-of feature 
    
    if not empty? location [
      let x item 0 location
      let y item 1 location
      
      create-work-locations 1 [
        setxy x y
        set color magenta
        set shape "square"
        set size 4
        set nearest-intersection find-nearest-intersection
      ]
    ]
  ]
end

to load-shop-locations
  foreach gis:feature-list-of shop-dataset [ feature ->
    let location gis:location-of gis:centroid-of feature 
    
    if not empty? location [
      let x item 0 location
      let y item 1 location
      
      create-shop-locations 1 [
        setxy x y
        set color blue
        set shape "square"
        set size 4
        set nearest-intersection find-nearest-intersection
      ]
    ]
  ]
end

;; Residents

to load-resident-groups 
  let data csv:from-file "data/model_input/resident_groups.csv"
  let rows but-first data
  
  foreach rows [ row ->
    create-resident-groups 1 [
      set group-name item 0 row
      set group-proportion item 1 row
      set work-start-hour item 2 row
      set work-start-spread item 3 row
      set work-end-hour item 4 row
      set work-end-spread item 5 row
      set shop-probability item 6 row
      set shop-duration item 7 row
      set shop-end-spread item 8 row
      set hidden? true
    ]
  ]
end

to add-residents [n]
  let next-id ifelse-value any? residents
    [ max [resident-id] of residents + 1 ] [ 0 ]
  
  let sorted-groups sort-on [group-name] resident-groups

  foreach sorted-groups [ g ->
    let group_n round (n * [group-proportion] of g)

    create-residents group_n [
      set resident-id next-id
      set next-id next-id + 1

      set group g
      
      set home-node [nearest-intersection] of one-of home-locations
      set work-node [nearest-intersection] of one-of work-locations
      
      move-to home-node
      set moving? false
      
      set current-goal "home-evening"
      set destination home-node

      set biodiversity-scores (list)
      set layers-scores (list)
      set archetypal-scores (list)
      set peace-scores (list)
      set CLM-scores (list)
      
      set color cyan
      set shape "person"
      set size 20
    ]
  ]

  ask residents [ schedule-next-goal ]
end

;; GO PROCEDURES ;;

to go
  ; Advance time by 1 tick
  time:go-until (ticks + 1)
  set day floor time:difference-between start-daytime time-of-day "days" 
  set today time:plus start-daytime day "days"
  
  ; Move residents
  move-residents
  
  ; Update outputs
  update-average-plot
  update-target-resident-plot
end

to go-until
  go

  if day >= until-days [
    export-results
    stop
  ]
end

to move-residents
  let speed (resident-speed / 3.6) * meter-conversion-factor * 60

  ask residents with [ moving? ] [
    follow-path speed
    measure-exposure
  ]
end

;; Movement

to follow-path [ remaining-speed ]
  if remaining-speed <= 0 [ stop ]
    
  ifelse distance next-node < remaining-speed [
    ; Node within reach, so move to it
    set remaining-speed remaining-speed - distance next-node
    move-to next-node

    ifelse next-node = destination [
      ; Destination reached
      set color cyan
      set moving? false
    ] 
    [
      ; Destination not yet reached, continue following the path
      set current-path but-first current-path
      set next-node first current-path
      follow-path remaining-speed
    ]
  ]
  [
    ; Move in the direction of the next node
    face next-node
    forward remaining-speed
  ]
end

to set-new-destination [ new-destination ]
  if new-destination = destination [ stop ]
  
  let path nobody
  let current-node destination
  set destination new-destination

  ask current-node [ set path nw:turtles-on-weighted-path-to new-destination length-meters ]
  
  ifelse path != false and length path > 1 [
    set color yellow
    set current-path but-first path
    set next-node first current-path
    set moving? true
  ]
  [
    set color red
    set current-path false
    set moving? false
  ]
end

;; Schedule

to schedule-next-goal
  ; Default to going home for the night
  let next-goal "home-evening"
  let next-destination home-node
  let next-goal-end time:plus today 1 "day"

  (ifelse
    ; If at home in the morning, go to work
    current-goal = "home-morning" [
      set next-goal "work"
      set next-destination work-node
      set next-goal-end random-normal-time
        (time:plus today ([work-end-hour] of group) "hours")
        ([work-end-spread] of group)
    ]
    ; If at work, possibly go to a shop
    current-goal = "work" [
      let p random 100
      if p <= [shop-probability] of group [
        set next-goal "shop"
        set next-destination [nearest-intersection] of one-of shop-locations
        set next-goal-end random-normal-time
          (time:plus time-of-day ([shop-duration] of group) "minutes")
          ([shop-end-spread] of group)
      ]
    ]
    ; If at home in the evening, stay at home in the morning until it is time for work
    current-goal = "home-evening" [
      set next-goal "home-morning"
      set next-destination home-node
      set next-goal-end random-normal-time 
        (time:plus time-of-day ([work-start-hour] of group) "hours")
        ([work-start-spread] of group)
    ]
  )

  set current-goal next-goal
  set-new-destination next-destination

  time:schedule-event self [ [] -> 
    schedule-next-goal
  ] next-goal-end
end

to-report random-normal-time [ mean-time sd-minutes ]
  let offset round random-normal 0 sd-minutes
  let result time:plus mean-time offset "minutes"

  ifelse time:is-after? result time-of-day
    [ report result ]
    [ report time:plus time-of-day 1 "minutes" ]
end

;; CLM scores

to measure-exposure
  let sample min-one-of sample-points [ distance myself ]

  ask sample [set visits (visits + 1)]

  set biodiversity-scores lput [biodiversity-score] of sample biodiversity-scores
  set layers-scores lput [layers-score] of sample layers-scores
  set archetypal-scores lput [archetypal-score] of sample archetypal-scores
  set peace-scores lput [peace-score] of sample peace-scores
  set CLM-scores lput [CLM-score] of sample CLM-scores
end


;; OUTPUT PROCEDURES ;;

to-report get-target-score-history
  if target-score = "biodiversity" [ report biodiversity-scores ]
  if target-score = "layers of the landscape" [ report layers-scores ]
  if target-score = "archetypal elements" [ report archetypal-scores ]
  if target-score = "character of peace and silence" [ report peace-scores ]
  if target-score = "CLM score" [ report CLM-scores ]
  report []
end

to-report get-mean [ history ]
  ifelse empty? history
    [ report 0 ]
    [ report mean history ]
end

;; Plots

to update-average-plot
  set-current-plot "Average Resident Score"
  set-current-plot-pen "average"
  
  let residents-to-include residents with [ not empty? get-target-score-history ]
  if not any? residents-to-include [ stop ]
  
  plot mean [ last get-target-score-history ] of residents-to-include
end

to update-target-resident-plot
  set-current-plot "Target Resident Score"
  set-current-plot-pen "score"
  
  let target one-of residents with [ resident-id = target-resident-id ]
  if target = nobody [ stop ]

  ask target [ set color red ]
  
  let history [ get-target-score-history ] of target
  if empty? history [ stop ]
  
  let i length history - 1
  plotxy i last history
end

;; Export

to export-results
  ask residents [
    let res self
    hatch-export-residents 1 [
      move-to [home-node] of res 

      set res_id [resident-id] of res
      set res_group [group] of res

      set biodiv_scr [get-mean biodiversity-scores] of res
      set layers_scr [get-mean layers-scores] of res
      set archtp_scr [get-mean archetypal-scores] of res
      set peace_scr [get-mean peace-scores] of res
      set CLM_scr [get-mean CLM-scores] of res

      print "Exporting resident with a mean CLM score of:"
      print CLM_scr
    ]
  ]
  
  let export-dataset gis:turtle-dataset export-residents
  gis:store-dataset export-dataset "data/model_output/resident_scores"

  print "Completed export to model_output/resident_scores.shp"
end