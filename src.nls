;; CLM PROCEDURES ;;

to measure-exposure
  set view-distance-netlogo view-distance * meter-conversion-factor
  
  let archetypal-score measure-archetypal-score
  set CLM-archetypal-scores lput archetypal-score CLM-archetypal-scores
  
  ask min-one-of intersections [ distance myself ] [
    set sum-archetypal-scores sum-archetypal-scores + archetypal-score
    set visit-count visit-count + 1
  ]
end


;; OUTPUT PROCEDURES ;;

to update-heatmap
  if target-score = "none" or not show-heatmap? [ 
    ask intersections with [ size > 0 ] [ set size 0 ]
    stop 
  ]
  
  ask intersections with [ visit-count > 0 ] [
    let sum-scores 0
    
    if target-score = "archetypal elements" [ set sum-scores sum-archetypal-scores ]
    
    let mean-score sum-scores / visit-count
    set color scale-color green mean-score 1 6
    if size = 0 [ set size 10 ]
  ]
end

;; Plots

to update-average-plot
  set-current-plot "Average Resident Score"
  set-current-plot-pen "average"
  
  let residents-to-include residents with [ not empty? get-score-history ]
  if not any? residents-to-include [ stop ]
  
  plot mean [ last get-score-history ] of residents-to-include
end

to update-target-resident-plot
  set-current-plot "Target Resident Score"
  set-current-plot-pen "score"
  
  let target one-of residents with [ resident-id = target-resident-id ]
  if target = nobody [ stop ]
  
  let history [ get-score-history ] of target
  if empty? history [ stop ]
  
  let i length history - 1
  plotxy i last history
end

to-report get-score-history
  if target-score = "archetypal elements" [ report CLM-archetypal-scores ]
  report []
end